// Deploy pipeline: syncs the static site content to S3 and invalidates
// CloudFront. Runs on every push to main. This pipeline does NOT touch
// Terraform/infra — that's handled by Jenkinsfile.infra separately.
//
// The actual render/sync/invalidate logic lives in ONE place:
// scripts/deploy-content.sh. This Jenkinsfile calls it rather than
// reimplementing its steps, so there is a single source of truth for how a
// deploy happens, used identically whether triggered by this pipeline or
// run by hand (see docs/DEPLOYMENT_GUIDE.md Phase 6).
//
// Requires Jenkins credentials:
//   - 'aws-deploy-creds'   (AWS Access Key / Secret Key, or use an IAM
//                              role on the agent instead)
// Requires Jenkins env vars (set via job parameters, see Phase 7.3):
//   - SITE_BUCKET, CLOUDFRONT_DISTRIBUTION_ID, SITE_DOMAIN
//     (SITE_DOMAIN must match the `domain_name` set in
//      terraform/environments/prod/terraform.tfvars — it replaces the
//      __SITE_DOMAIN__ token in public/**/*.html, robots.txt, sitemap.xml)
//     Setting all three here is what lets scripts/deploy-content.sh skip
//     its own `terraform output` lookup — see the comment at the top of
//     that script for why that matters for this pipeline's credential scope.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        SITE_BUCKET                 = "${SITE_BUCKET}"
        CLOUDFRONT_DISTRIBUTION_ID  = "${CLOUDFRONT_DISTRIBUTION_ID}"
        SITE_DOMAIN                 = "${SITE_DOMAIN}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Sanity Check') {
            steps {
                sh '''
                    test -f public/index.html || { echo "public/index.html not found"; exit 1; }
                    test -x scripts/deploy-content.sh || chmod +x scripts/deploy-content.sh
                '''
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-deploy-creds'
                ]]) {
                    sh './scripts/deploy-content.sh'
                }
            }
        }
    }

    post {
        success {
            echo "Deployed successfully to s3://${SITE_BUCKET}, CloudFront invalidation issued."
        }
        failure {
            echo "Deploy failed — check console output above."
        }
    }
}
